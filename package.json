{
  "name": "credora",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @credora/web --filter @credora/api --filter @credora/mobile dev",
    "dev:web": "pnpm --filter @credora/web dev",
    "dev:api": "pnpm --filter @credora/api dev",
    "dev:mobile": "pnpm --filter @credora/mobile start",
    "anvil": "anvil --host 127.0.0.1 --port 8545 --chain-id 31337 --accounts 10 --balance 10000",
    "contracts:deps": "git submodule update --init --recursive",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:e2e:backend": "pnpm --filter @credora/api exec node ../../tests/e2e/backend-smoke.mjs",
    "test:e2e:backend:routes": "pnpm --filter @credora/api exec node ../../tests/e2e/backend-routes.mjs",
    "test:e2e:backend:outage": "pnpm --filter @credora/api exec node ../../tests/e2e/backend-outage.mjs",
    "test:e2e:ipfs": "pnpm --filter @credora/api exec tsx ../../tests/e2e/ipfs-smoke.mjs",
    "lint": "pnpm exec prettier --check \"apps/**/*.{ts,tsx,js,jsx,mjs,json,css}\" \"packages/**/*.{ts,tsx,js,jsx,mjs,json}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" package.json pnpm-workspace.yaml \".github/workflows/*.yml\" deploy/docker-compose.yml deploy/README.md",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "contracts:test": "forge test --root contracts",
    "contracts:build": "forge build --root contracts",
    "contracts:deploy": "forge script script/Deploy.s.sol --root contracts --rpc-url http://127.0.0.1:8545 --broadcast"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "viem": "^2.55.13"
  }
}
