// Credora — connected end-to-end technical workflow
// Eraser Flow Chart editor. API operations are logical steps in one Node service.
direction down
typeface clean
styleMode plain
colorMode pastel

prepare [label: "01 · Access and issuance preparation"] {
  Issuer [icon: next, color: blue, shape: rectangle, label: "Issuer web workspace / Connect external wallet"]
  Authenticate [icon: key-round, color: purple, shape: rectangle, label: "Authenticate wallet / /auth/challenge → personal_sign → /auth/verify"]
  OrgReview [icon: building-2, color: purple, shape: rectangle, label: "Organization enrollment / Superadmin review + v3 activation → initial owner is admin and issuer"]
  IssuerGate [icon: shield-check, color: purple, shape: diamond, label: "Issuer authorized? / v1 global role or organization-scoped v3 authority"]
  Grant [icon: wallet, color: blue, shape: rectangle, label: "Organization admin delegates issuer / v3 setIssuerAuthorization"]
  Draft [icon: file-plus, color: purple, shape: rectangle, label: "Create issuance draft / POST /issuances · learner + skill + issue date"]
  Upload [icon: upload-cloud, color: purple, shape: rectangle, label: "Upload public manifest / POST /issuances/:id/metadata"]
  Hash [icon: hash, color: purple, shape: rectangle, label: "Compute credential hash / Versioned ABI payload + metadata URI → Keccak-256"]
  Sign [icon: wallet, color: blue, shape: rectangle, label: "Issuer wallet signs / issueCredential(hash, learner, metadataUri)"]
}

commit [label: "02 · Anchoring, discovery and sharing"] {
  Rpc [icon: ethereum, color: green, shape: rectangle, label: "EVM RPC broadcasts transaction / Issuer key stays in wallet"]
  Registry [icon: solidity, color: green, shape: rectangle, label: "Credential registries v1 + v3 / Immutable record · issuer check · issuance event"]
  Confirm [icon: badge-check, color: purple, shape: rectangle, label: "Validate transaction and receipt / POST /issuances/:id/confirm · sender + record bindings"]
  Sync [icon: refresh-cw, color: purple, shape: rectangle, label: "API event reconciliation / Poll CredentialIssued · confirmations · reorg rescan"]
  Holder [icon: next, color: blue, shape: rectangle, label: "Holder web wallet / Save public credential references"]
  Share [icon: share-2, color: purple, shape: rectangle, label: "Create fixed credential bundle / POST /wallet/shares · 1–25 hashes · 1/7/30 days"]
  Qr [icon: qr-code, color: blue, shape: rectangle, label: "Share URL / QR / Bearer link + separate management/revoke secret"]
}

verification [label: "03 · Public proof verification"] {
  Verifier [icon: scan-line, color: blue, shape: rectangle, label: "Verifier opens link or scans QR / No login required"]
  Resolve [icon: list-checks, color: purple, shape: rectangle, label: "Resolve active share / POST /wallet/share-resolution (token in body) → selected hashes"]
  Parse [icon: binary, color: purple, shape: diamond, label: "Valid 32-byte reference? / Validate configured credential reference"]
  Route [icon: network, color: purple, shape: diamond, label: "API reachable? / Web verification request"]
  Direct [icon: globe, color: blue, shape: rectangle, label: "Web direct verification / Fallback to configured RPC + public IPFS gateway"]
  Read [icon: search, color: purple, shape: rectangle, label: "Read immutable chain record / getCredential(hash) via configured EVM RPC"]
  Exists [icon: file-question-mark, color: purple, shape: diamond, label: "Record exists? / Selected chain + registry"]
  Fetch [icon: download-cloud, color: purple, shape: rectangle, label: "Fetch manifest by CID / Read ipfs:// URI through HTTP gateway"]
  Match [icon: fingerprint, color: purple, shape: diamond, label: "Proof matches? / Normalize · recompute Keccak · compare bound fields"]
  Independent [icon: terminal, color: blue, shape: rectangle, label: "Independent verifier / Direct RPC + gateway · no Credora API"]
}

results [label: "04 · Verification outcomes"] {
  Valid [icon: circle-check, color: green, shape: rectangle, label: "Valid credential / Registry + metadata proof match"]
  Mismatch [icon: shield-x, color: red, shape: rectangle, label: "Metadata / proof mismatch / Does not establish wallet control"]
  Absent [icon: file-x, color: orange, shape: rectangle, label: "Credential not found / Absent from selected registry"]
  Malformed [icon: triangle-alert, color: red, shape: rectangle, label: "Malformed reference / Reject before proof lookup"]
  LedgerDown [icon: unplug, color: orange, shape: rectangle, label: "Ledger unavailable / RPC / registry read failure"]
  MetadataDown [icon: cloud-off, color: orange, shape: rectangle, label: "Metadata unavailable / Gateway / retrieval failure"]
}

resources [label: "Shared persistence and metadata"] {
  Sqlite [icon: sqlite, color: orange, shape: rectangle, label: "Persistent SQLite / Sessions · org decisions · drafts · shares · chain views"]
  Ipfs [icon: ipfs, color: green, shape: rectangle, label: "IPFS content-addressed storage / Public manifest bytes · CID ≠ credential hash"]
  Backup [icon: database-backup, color: gray, shape: rectangle, label: "Rotating SQLite backups / Operational records need durable backups"]
}

Issuer > Authenticate: 1 · connect + sign [color: blue]
Authenticate > IssuerGate: 2 · bearer session [color: blue]
Authenticate --> OrgReview: optional enrollment [color: gray]
OrgReview --> Sqlite: review decision [color: orange]
IssuerGate > Grant: No · admin action [color: orange]
Grant --> IssuerGate: signed on-chain grant [color: blue]
IssuerGate --> Registry: isAuthorizedIssuer [color: green]
IssuerGate > Draft: Yes [color: green]
Draft > Upload: 3 · manifest [color: purple]
Upload --> Ipfs: put JSON [color: green]
Upload > Hash: 4 · returned CID / URI [color: purple]
Hash > Sign: 5 · hash + learner + URI [color: blue]
Sign > Rpc: 6 · signed transaction [color: blue]
Rpc > Registry: issueCredential [color: green]
Registry > Confirm: 7 · transaction hash / receipt [color: green]
Registry > Sync: confirmed event logs [color: purple]
Confirm > Holder: 8 · public proof reference [color: blue]
Sync --> Sqlite: rebuildable projection [color: orange]
Sqlite --> Holder: GET /credentials discovery [color: orange]
Sqlite --> Backup: snapshot [color: orange]
Authenticate --> Sqlite: session [color: orange]
Draft --> Sqlite: persist operation [color: orange]
Share --> Sqlite: token digests + fixed hashes [color: orange]
Holder > Share: 9 · select + expiry [color: blue]
Share > Qr: share token [color: blue]
Qr > Verifier: 10 · present / scan [color: blue]
Verifier > Resolve: share URL [color: purple]
Verifier --> Parse: direct credential hash [color: blue]
Resolve > Parse: each selected hash [color: purple]
Parse > Malformed: No [color: red]
Parse > Route: Yes [color: purple]
Route > Direct: No · web fallback [color: blue]
Route > Read: Yes · API verifier [color: purple]
Direct > Read: API-independent read [color: blue]
Independent --> Read: bypass API [color: blue]
Read --> Registry: getCredential [color: green]
Read > LedgerDown: RPC failure [color: orange]
Read > Exists: chain record [color: purple]
Exists > Absent: No [color: orange]
Exists > Fetch: Yes · metadata URI [color: purple]
Fetch --> Ipfs: gateway GET by CID [color: green]
Fetch > MetadataDown: fetch failure [color: orange]
Fetch > Match: manifest + record [color: purple]
Match > Mismatch: No [color: red]
Match > Valid: Yes [color: green]

// Public v1 fields remain public; share expiry/revocation does not revoke credentials.
// One-time v3 activation grants the initial owner admin and issuer authority.
// Organization issuers are delegated by their own admins; routine issuance needs no superadmin approval.
// Registry issuedAt is block time; payload issue date is a separate hash input.
// Wallet keys never enter the API; verification does not prove presenter wallet control.
// V2 selective disclosure remains a protocol-library capability, not this v1 app flow.
