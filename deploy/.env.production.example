# Set every required value before starting the production stack.
CREDORA_DOMAIN=

# Public web configuration. NEXT_PUBLIC_* values are embedded in browser assets
# at build time and read by server-rendered routes at container runtime.
# Optional public Supabase Auth configuration. These values are embedded in the browser build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CREDENTIAL_REGISTRY_ADDRESS=
NEXT_PUBLIC_ORGANIZATION_CREDENTIAL_REGISTRY_ADDRESS=
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://ipfs.filebase.io/ipfs

# API configuration. Use the same chain and registry values as the browser settings.
API_PORT=4000
API_DATABASE_PATH=/data/credora.sqlite
API_STORAGE_PATH=/data/metadata
API_ALLOWED_ORIGINS=
API_HSTS=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
RPC_URL=
CHAIN_ID=
CREDENTIAL_REGISTRY_ADDRESS=
ORGANIZATION_CREDENTIAL_REGISTRY_ADDRESS=
CHAIN_START_BLOCK=0
CHAIN_CONFIRMATIONS=12
CHAIN_SYNC_INTERVAL_MS=30000

# Set these with the credentials issued by the chosen IPFS provider.
IPFS_UPLOAD_URL=https://rpc.filebase.io/api/v0/add?cid-version=1
IPFS_UPLOAD_AUTH_TOKEN=replace-with-server-only-upload-token
IPFS_GATEWAY_URL=https://ipfs.filebase.io/ipfs
IPFS_GATEWAY_AUTH_TOKEN=
IPFS_REQUEST_TIMEOUT_MS=15000

API_BACKUP_PATH=/data/backups
API_BACKUP_RETENTION=14
