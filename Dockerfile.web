FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages packages
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_RPC_URL
ARG NEXT_PUBLIC_CHAIN_ID
ARG NEXT_PUBLIC_CREDENTIAL_REGISTRY_ADDRESS
ARG NEXT_PUBLIC_ORGANIZATION_CREDENTIAL_REGISTRY_ADDRESS
ARG NEXT_PUBLIC_IPFS_GATEWAY_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_RPC_URL=${NEXT_PUBLIC_RPC_URL}
ENV NEXT_PUBLIC_CHAIN_ID=${NEXT_PUBLIC_CHAIN_ID}
ENV NEXT_PUBLIC_CREDENTIAL_REGISTRY_ADDRESS=${NEXT_PUBLIC_CREDENTIAL_REGISTRY_ADDRESS}
ENV NEXT_PUBLIC_ORGANIZATION_CREDENTIAL_REGISTRY_ADDRESS=${NEXT_PUBLIC_ORGANIZATION_CREDENTIAL_REGISTRY_ADDRESS}
ENV NEXT_PUBLIC_IPFS_GATEWAY_URL=${NEXT_PUBLIC_IPFS_GATEWAY_URL}
ENV NEXT_TELEMETRY_DISABLED=1

RUN VITE_SUPABASE_URL="${VITE_SUPABASE_URL}" \
    VITE_SUPABASE_PUBLISHABLE_KEY="${VITE_SUPABASE_PUBLISHABLE_KEY}" \
    pnpm --filter @credora/web build

FROM node:22-alpine
WORKDIR /app/apps/web
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# NEXT_PUBLIC_* build values above populate browser assets. Compose must also
# pass them to this container at runtime for server-rendered routes.
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 3000
CMD ["node", "./server.mjs"]
